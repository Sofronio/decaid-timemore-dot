{
  "id": "timemore-dot.reaplugin",
  "name": "Timemore Dot Scale (Reference)",
  "author": "Decaid contributors",
  "description": "Opt-in Timemore Dot protocol reference using host-owned BLE.",
  "version": "0.1.0",
  "apiVersion": 1,
  "permissions": ["transport.ble"],
  "drivers": [{
    "id": "timemore-dot",
    "type": "scale",
    "capabilities": ["battery", "tare", "timerControl", "timerTelemetry", "disconnectToSleep"],
    "ble": {"match": {"name": {"contains": "dot"}, "serviceUuids": ["fff0"]}}
  }],
  "settings": {},
  "api": []
}
